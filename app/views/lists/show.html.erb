<div class="card-category mb-3" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= "http://loremflickr.com/1000/200/#{@list.name.downcase}" %>)">
  <%= @list.name %>
</div>

<div class="cards mb-2">
  <% @list.bookmarks.each do |bookmark| %>
    <div class="card-product">
      <img src="<%= bookmark.movie.poster_url %>" />
      <div class="d-flex justify-content-between align-items-center">
        <div class="card-product-infos">
          <h2><%= bookmark.movie.title %></h2>
          <p><%= bookmark.comment %></p>
        </div>
        <div>
          <%= link_to "🗑️", bookmark_path(bookmark), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
        </div>
      </div>
    </div>

  <% end %>
</div>




<%= link_to "➕ Add new movie", new_list_bookmark_path(@list), class: "btn btn-warning w-100" %>
